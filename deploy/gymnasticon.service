
[Unit]
Description=Gymnasticon
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
WorkingDirectory=/opt/gymnasticon
ExecStart=/usr/bin/node /opt/gymnasticon/dist/app/cli.js
User=pi
Group=pi

# Enhanced capability settings
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=no

# Environment variables
Environment=NODE_ENV=production
Environment=DEBUG=gym:*
Environment=NOBLE_HCI_DEVICE_ID=hci0
Environment=BLENO_HCI_DEVICE_ID=hci0
Environment=NOBLE_MULTI_ROLE=1

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
