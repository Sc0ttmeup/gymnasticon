[Unit]
Description=Gymnasticon2
#After=bluetooth-init.service bluetooth.service network.target
After=bluetooth.service network.target
#Requires=bluetooth-init.service bluetooth.service
Requires=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/gymnasticon/lib/app/cli.js
WorkingDirectory=/opt/gymnasticon
Restart=always
RestartSec=10
User=pi
Group=pi
Environment=NODE_ENV=production
Environment=DEBUG=gym:*
Environment=NOBLE_HCI_DEVICE_ID=hci0
Environment=BLENO_HCI_DEVICE_ID=hci0
Environment=NOBLE_MULTI_ROLE=1
StandardOutput=append:/var/log/gymnasticon.log
StandardError=append:/var/log/gymnasticon.log
SyslogIdentifier=gymnasticon
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
